{
  "name": "dsh-workbench-core",
  "version": "0.2.1",
  "description": "项目管理、浏览器、桌面操作与 Git 协作，一次安装，按需开启。",
  "private": false,
  "type": "module",
  "main": "./components/chief/suite.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "components",
    "preset.js",
    "provenance.json",
    "locale",
    "persona",
    "cli"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "agent-browser": "0.41.2",
    "agent-desktop": "1.2.0",
    "dsh-x-memory": "0.1.1",
    "dsh-context": "0.83.1",
    "dsh-ops": "0.5.2",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanlinxuy/dsh-workbench.git",
    "directory": "bundles/core"
  },
  "exports": {
    ".": "./components/chief/suite.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./chief": "./components/chief/suite.js",
    "./chief/locale/*": "./locale/chief/*",
    "./browser": "./components/browser/index.js",
    "./browser/locale/*": "./locale/browser/*",
    "./desktop": "./components/desktop/index.js",
    "./desktop/locale/*": "./locale/desktop/*",
    "./git": "./components/git/index.js",
    "./git/locale/*": "./locale/git/*",
    "./client": "./components/chief/client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "bin": {
    "dsh-workbench": "./cli/workbench.mjs"
  }
}
