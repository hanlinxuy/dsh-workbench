{
  "name": "dsh-workbench-core",
  "version": "0.2.7",
  "description": "\u9879\u76ee\u7ba1\u7406\u3001\u6d4f\u89c8\u5668\u3001\u684c\u9762\u64cd\u4f5c\u4e0e Git \u534f\u4f5c\uff0c\u4e00\u6b21\u5b89\u88c5\uff0c\u6309\u9700\u5f00\u542f\u3002",
  "private": false,
  "type": "module",
  "main": "./components/chief/suite.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "components",
    "preset.js",
    "provenance.json",
    "locale",
    "persona",
    "cli",
    "settings"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "agent-browser": "0.41.2",
    "agent-desktop": "1.2.0",
    "dsh-x-memory": "0.1.1",
    "dsh-context": "0.83.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanlinxuy/dsh-workbench.git",
    "directory": "bundles/core"
  },
  "exports": {
    ".": "./components/chief/suite.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./chief": "./components/chief/suite.js",
    "./chief/locale/*": "./locale/chief/*",
    "./browser": "./components/browser/index.js",
    "./browser/locale/*": "./locale/browser/*",
    "./desktop": "./components/desktop/index.js",
    "./desktop/locale/*": "./locale/desktop/*",
    "./git": "./components/git/index.js",
    "./git/locale/*": "./locale/git/*",
    "./client": "./components/chief/client.js",
    "./settings": "./settings/runtime.js",
    "./settings/locale/*": "./settings/locale/*",
    "./provider-gateway": "./components/provider-gateway/index.js",
    "./provider-gateway/locale/*": "./locale/provider-gateway/*"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "bin": {
    "dsh-workbench": "./cli/workbench.mjs"
  }
}
