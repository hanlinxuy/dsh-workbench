{
  "name": "dsh-workbench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "harness": "node dev/plugin-harness/scripts/cli.mjs",
    "build": "pnpm --dir plugins/chief run build",
    "check": "node plugins/chief/build-client.js --check && node scripts/build-bundles.mjs --check",
    "test": "node --test plugins/chief/*.test.js plugins/browser/*.test.js plugins/desktop/*.test.js plugins/git/*.test.js plugins/provider-gateway/*.test.js bundles/test/*.test.js dev/plugin-harness/*.test.js",
    "pack:chief": "pnpm --dir plugins/chief pack --pack-destination ../../dist",
    "pack:browser": "pnpm --dir plugins/browser pack --pack-destination ../../dist",
    "pack:desktop": "pnpm --dir plugins/desktop pack --pack-destination ../../dist",
    "pack:git": "pnpm --dir plugins/git pack --pack-destination ../../dist",
    "build:bundles": "node scripts/build-bundles.mjs",
    "pack:suite": "pnpm --dir bundles/workbench pack --pack-destination ../../dist",
    "pack:core": "pnpm --dir bundles/core pack --pack-destination ../../dist",
    "release:bundles": "node scripts/release-bundles.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
